# =============================================================================
# COE local-LLM bring-up — copy these keys into your .env and restart backend.
#
# For a COE-hosted model served OpenAI-compatible (vLLM / sglang / llama.cpp /
# TGI — same family as a local Kimi deployment). The AI-SOC backend only needs
# an OpenAI-style /v1/chat/completions endpoint; it never calls the model's
# host, GPUs, or weights directly.
#
# After editing: `docker compose up -d` (or restart the backend), then open the
# "Ask LLM" page — the health cards show reachable / throughput / status.
# =============================================================================

# 1) Turn the governed LLM layer on.
AI_SOC_LLM_ENABLED=true

# 2) Use "local" mode. IMPORTANT: pick "local" (not "openai_compatible") so the
#    runtime-health probe + Ask LLM debug cards work — they read the LOCAL_* keys.
AI_SOC_LLM_MODE=local

# 3) Endpoint. MUST include the /v1 suffix (the client appends /chat/completions).
#    Use the address the *backend container* can reach — see the doc on Docker
#    networking. Example for a model box on the LAN:
AI_SOC_LLM_LOCAL_BASE_URL=http://COE-LLM-HOST:8000/v1

# 4) Model name EXACTLY as the server advertises it in GET /v1/models
#    (e.g. moonshotai/Kimi-K2-Instruct, or whatever COE serves).
AI_SOC_LLM_LOCAL_MODEL=REPLACE_WITH_SERVED_MODEL_ID

# 5) API key — leave blank if the COE server has no auth; else the bearer token.
AI_SOC_LLM_LOCAL_API_KEY=

# 6) Display label(s) for the Ask LLM model selector (cosmetic only).
AI_SOC_LLM_ACTIVE_MODEL=REPLACE_WITH_SERVED_MODEL_ID
AI_SOC_LLM_AVAILABLE_MODELS=REPLACE_WITH_SERVED_MODEL_ID

# 7) Timeout ceiling (seconds). A big model on cold cache can be slow; 120 is safe.
AI_SOC_LLM_TIMEOUT_SECONDS=120

# --- Optional: also let live /chat narrate its analyst summary with this model.
#     Leave OFF for the Ask LLM page alone. Facts stay deterministic regardless.
# AI_SOC_LLM_FINAL_SYNTHESIS_ENABLED=true
# AI_SOC_LLM_LIVE_SYNTHESIS_ENABLED=true

# --- Optional: graceful "Restart LLM" button. Only meaningful if a host watcher
#     manages the COE model service; leave off unless that is wired at COE.
# AI_SOC_LLM_CONTROL_ENABLED=false
