.env
__pycache__/
.pytest_cache/
.venv/
node_modules/
dist/
.DS_Store
*.pyc
test_harness/audit_logs/*.jsonl
docs/evals/out/*
!docs/evals/out/.gitkeep

# Local staging scorecard corpus (regenerated by the synthesis smoke; not committed)
docs/evals/llm_role_traces_staging.jsonl

# stray staging trace dumps
backend/staging_traces*.jsonl

# Runtime auth registry (per-deploy; bootstrap from users.example.json or env)
backend/app/auth/users.json
backend/app/data/cve_snapshot/
# UI-persisted LLM connection override holds an api key — never commit.
backend/data/llm_connection.json
# UI-persisted MCP connection override holds a Splunk MCP encrypted token.
backend/data/mcp_connection.json

# Cursor agent handoff artifact (generated by stop hook)
.cursor/last-handoff.md
.cursor/hooks/DISABLE_VERIFY_ON_STOP
.cursor/hooks/.verify-requested

# live-efficacy eval run output (P0/P1 diagnostics; canonical banks
# live_efficacy_100_bank.json / _labels.json + 100/{report,findings}.md stay tracked)
docs/evals/live_efficacy_*_stdout.log
docs/evals/live_efficacy_100/checkpoint.json
docs/evals/live_efficacy_100/results.json
docs/evals/live_efficacy_100_baseline*/
docs/evals/live_efficacy_28_reclassify/
docs/evals/live_efficacy_indeterminate*/
docs/evals/live_efficacy_last*/
docs/evals/live_efficacy_transport*/

# Shared LLM-control queue (runtime sentinels; created by docker-compose bind mount)
.llm-control/

# Operator artifacts — env smoke backups and rollout snapshots (may hold secrets; never commit)
.env.smoke-backup-*
docs/coe/rollout-snapshots/
.cursor/hooks/.loop-asap-requested
