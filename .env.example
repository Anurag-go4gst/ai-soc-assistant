ROUTING_MODE=llm_primary
DEBUG_TRACE_ENABLED=true
ROUTING_DETERMINISTIC_THRESHOLD=0.70
ROUTING_LLM_SHADOW_ENABLED=true
ROUTING_COMPARE_LOGGING_ENABLED=true

# AI-SOC product telemetry sink. Supported today: db | none.
# Planned (not yet implemented; backend will refuse to start): splunk | both.
AI_SOC_TELEMETRY_SINK=db

APP_AUTH_ENABLED=true
APP_AUTH_USER=analyst
APP_AUTH_PASSWORD=
APP_AUTH_SESSION_SECRET=
