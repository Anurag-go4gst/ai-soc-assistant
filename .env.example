APP_ENV=development
BACKEND_PORT=8010
FRONTEND_PORT=3010
DATABASE_URL=postgresql://ai_soc:change-me@postgres:5432/ai_soc_assistant

# Safe default: no real MCP, RAG, model, embedding, or Splunk telemetry execution.
MCP_MODE=mock
MCP_DEFAULT_SERVER=splunk_soc
MCP_GLOBAL_EXECUTION_ENABLED=false
MCP_SERVER_MOCK_EXECUTION_ENABLED=false
MCP_DISCOVERY_ENABLED=true
# Async Splunk search job lifecycle bounds (connector-internal; used in live
# registry mode). Defaults shown; for go-live see .env.splunk-live.example.
MCP_MAX_POLLS_PER_CALL=60
MCP_SEARCH_JOB_TIMEOUT_MS=120000
MCP_SEARCH_POLL_INTERVAL_MS=2000
# Batch 1 HIL hardening: a successful mock MCP execution surfaces an analyst-review
# gate by default. The without-HIL relaxation applies ONLY when BOTH the deployment
# is explicitly flagged demo/lab AND the allowance is enabled (two independent axes).
AI_SOC_REQUIRE_HIL_FOR_MOCK_EXECUTION=true
AI_SOC_ALLOW_MOCK_EXECUTION_WITHOUT_HIL_IN_DEMO=true
AI_SOC_DEMO_OR_LAB_EXECUTION_MODE=false
RAG_MODE=mock
# SOC surface posture (2026-06-09): all governance layers ON everywhere —
# eval/dev/prod run the same shape; no per-environment profiles. MCP execution
# flags stay false in every case. See plans/2026-06-09_1827_105-path-honoring-smb-analytics.md.
CONTROL_PLANE_ENABLED=true
# Two-stage pipeline dispatch authority (intent_dispatch + pipeline_dispatch).
# Code default false until Phase 8 green (governance byte-identity). Set true in
# .env for on-host dispatch probes from Phase 2A onward. See
# plans/2026-06-29_conditional-pipeline-canonical-dispatch.md.
AI_SOC_PIPELINE_DISPATCH_V2_ENABLED=false
# Per-tenant SPL allowlist overlay for the dynamic allowlist check (JSON:
# {"<tenant_id>": {"indexes": [...], "sourcetypes": [...]}}). Empty = single-tenant
# global SPL_ALLOWED_* policy applies. Set per deployment when multi-tenant.
AI_SOC_TENANT_SOURCETYPE_MAP=
# Batch 5 — lightweight investigation session pins (structured only; no transcript).
AI_SOC_SESSION_CONTEXT_ENABLED=true
AI_SOC_SESSION_CONTEXT_TTL_MINUTES=30
# Answer-quality ledger and review queue (Phase 1–3). Feedback works when ledger records turns; review UI needs these.
# Enable for /quality reviewer UI + promote-golden; set allowlist or ANY flag.
QUALITY_REVIEW_ENABLED=false
QUALITY_REVIEW_USER_ALLOWLIST=
QUALITY_REVIEW_ALLOW_ANY_AUTHENTICATED=false
# Stage 3G.1 governed RAG completion — all disabled by default (mock/no-op).
SOC_KB_RERANKER_ENABLED=false
SOC_KB_RERANKER_PROVIDER=mock
SOC_KB_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
SOC_KB_RERANKER_BASE_URL=
SOC_KB_RERANKER_API_KEY=
SOC_KB_RERANKER_TIMEOUT_SECONDS=10
SOC_KB_RERANKER_TOP_N=5
SOC_KB_LLM_AMBIGUITY_ASSIST_ENABLED=false
SOC_KB_LLM_AMBIGUITY_PROVIDER=
SOC_KB_LLM_AMBIGUITY_MAX_CANDIDATES=5
LLM_MODE=mock
LLM_HEALTH_CANARY_ENABLED=false
LLM_TOOL_RECOMMENDATION_ENABLED=false
EMBEDDINGS_MODE=mock
TELEMETRY_MODE=db
SPL_VALIDATION_ENABLED=true
SPL_ALLOWED_INDEXES=pgcil_soc
SPL_ALLOWED_SOURCETYPES=pgcil:auth,aws:cloudtrail,pgcil:edr,pgcil:dns,pgcil:firewall,pgcil:vpn,pgcil:network,WinEventLog:Security,XmlWinEventLog:Microsoft-Windows-Sysmon/Operational,cisco:firepower,cisco:ise,cisco:ios,cisco:stealthwatch,cisco:tacacs,cisco:wlc,cisco:duo,cisco:amp,ot:auth,ot:modbus,ot:dnp3,ot:scada,ot:pmu,ot:meter,ot:firewall
SPL_DEFAULT_EARLIEST=-24h
SPL_DEFAULT_LATEST=now
SPL_MAX_RESULT_LIMIT=100
SPL_ALLOWED_COMMANDS=search,stats,where,table,fields,sort,dedup,rename,eval,timechart,bin,bucket,head,streamstats,iplocation,mvexpand
SPL_BLOCKED_COMMANDS=delete,collect,outputlookup,sendemail,script,map,rest,loadjob,inputlookup
# Tier-2 governed-template lookup allowlist (Cisco power-grid Wave 3). Validator
# accepts these lookup files only inside governed templates that declare them in
# validation_rules; lab drafts + LLM SPL stay Tier-1. Live template promotion
# still requires the physical lookup CSVs to exist in Splunk (operator step).
SPL_ALLOWED_LOOKUPS=ot_asset_inventory.csv,ot_assets.csv,cii_registry.csv,cert_in_ioc.csv,master_stations.csv,physical_access.csv
SPL_ALLOW_JOIN_IN_GOVERNED_TEMPLATES=true
SPL_ALLOW_TRANSACTION_IN_GOVERNED_TEMPLATES=true

# Legacy placeholders retained for current mock connectors.
SPLUNK_MCP_ENABLED=false
AI_SOC_ENVIRONMENT_MODE=coe
SPLUNK_MCP_SERVER_ID=splunk_soc
SPLUNK_MCP_DISCOVERY_MODE=dynamic
SPLUNK_AI_ASSISTANT_MODE=auto
SPLUNK_SAIA_TOOLS_ENABLED=true
SPLUNK_USE_SAIA_GENERATE_SPL=true
SPLUNK_USE_SAIA_EXPLAIN_SPL=true
SPLUNK_USE_SAIA_OPTIMIZE_SPL=true
SPLUNK_USE_SAIA_ASK_QUESTION=true
SPLUNK_SAIA_REQUIRE_DISCOVERY=true
SPLUNK_ALLOW_RUN_SAVED_SEARCH=false
SPLUNK_RUN_SAVED_SEARCH_REQUIRE_HIL=true
SPLUNK_RUN_QUERY_REQUIRE_VALIDATION=true
SPLUNK_METADATA_DISCOVERY_ALLOWED=true
SPLUNK_KNOWLEDGE_OBJECT_DISCOVERY_ALLOWED=true
SPLUNK_ALLOWED_CORE_TOOLS=splunk_run_query,splunk_get_info,splunk_get_indexes,splunk_get_index_info,splunk_get_metadata,splunk_get_user_info,splunk_get_knowledge_objects
SPLUNK_ALLOWED_SAIA_TOOLS=saia_generate_spl,saia_explain_spl,saia_optimize_spl,saia_ask_splunk_question
SPLUNK_MCP_BASE_URL=
SPLUNK_MCP_TOKEN=
AI_SOC_MCP_CONNECTION_STORE_PATH=
LLM_ENABLED=false
FOUNDATION_SEC_INSTRUCT_URL=
FOUNDATION_SEC_REASONING_URL=
REASONING_ENABLED=false

# Stage 3J-B governed LLM layer (configuration/readiness only).
# Nothing here calls a real LLM. AI_SOC_LLM_MODE is canonical: "disabled" forces
# the layer off. Valid modes: mock|local|openai_compatible|cisco_foundation_sec|disabled.
# AI_SOC_LLM_FINAL_SYNTHESIS_ENABLED and AI_SOC_LLM_ANSWER_GUARD_ENABLED are inert
# flags — no synthesis or answer guard exists yet; keep them false.
AI_SOC_LLM_ENABLED=false
AI_SOC_LLM_MODE=mock
AI_SOC_LLM_ALLOW_CLOUD=false
AI_SOC_LLM_AIRGAP_ENFORCED=false
AI_SOC_LLM_DEFAULT_PROVIDER=
AI_SOC_LLM_DEFAULT_MODEL=
# Direct-LLM lab model display/selection (advisory only — does NOT hot-swap the
# llama-server, which loads the model pinned in its systemd unit). Active label +
# comma-separated allowlist surfaced by the Ask LLM page.
AI_SOC_LLM_ACTIVE_MODEL=foundation-sec-1.1-8b-instruct-q8_0
AI_SOC_LLM_AVAILABLE_MODELS=foundation-sec-1.1-8b-instruct-q8_0
AI_SOC_LLM_TIMEOUT_SECONDS=30
# Protected wall-time reserve for the intent-advisor hop. This is deliberately
# smaller than the full sidecar timeout so T2 intent/slot extraction can run
# when enough time remains for a bounded classifier call.
AI_SOC_LLM_INTENT_ADVISOR_RESERVE_SECONDS=12
# Wall-clock ceiling for ALL blocking LLM calls on one /chat turn (caps stacked
# sidecars on the slow on-prem model; deterministic answer always ships). 0 disables.
AI_SOC_LLM_TURN_DEADLINE_SECONDS=75
AI_SOC_LLM_MAX_INPUT_TOKENS=8000
AI_SOC_LLM_MAX_OUTPUT_TOKENS=1024
AI_SOC_LLM_TEMPERATURE=0.2
AI_SOC_LLM_STREAMING=false
AI_SOC_LLM_LOG_PROMPTS=false
AI_SOC_LLM_LOG_RESPONSES=false
AI_SOC_LLM_REDACT_SECRETS=true
# Role -> provider/model mappings (leave blank until a provider is configured).
AI_SOC_LLM_ROLE_SYNTHESIS_PROVIDER=
AI_SOC_LLM_ROLE_SYNTHESIS_MODEL=
AI_SOC_LLM_ROLE_REASONING_PROVIDER=
AI_SOC_LLM_ROLE_REASONING_MODEL=
AI_SOC_LLM_ROLE_ROUTER_PROVIDER=
AI_SOC_LLM_ROLE_ROUTER_MODEL=
# Planner-led Phase 2: advisory intent assist only (never authoritative).
AI_SOC_LLM_INTENT_ADVISOR_ENABLED=true
# Planner-led Phase 3: path/tool selection node (schedules branches only).
AI_SOC_PLANNER_PATH_SELECTION_ENABLED=true
# Planner-led Phase 5B: MITRE evidence-status branch authority.
AI_SOC_PLANNER_MITRE_BRANCH_ENABLED=true
# Planner-led Phase 6: runtime SPL template governance.
AI_SOC_SPL_TEMPLATE_GOVERNANCE_ENABLED=true
# Lab-only SPL draft preview when governed template/source profile is unavailable (never executable).
AI_SOC_SPL_DRAFT_PREVIEW_ENABLED=true
# T2 power-industry probe posture (P0): shape router + surfacing on in lab.
AI_SOC_T2_ANSWER_SHAPE_ENABLED=true
AI_SOC_T2_ANSWER_SURFACING_ENABLED=true
AI_SOC_T2_RAG_SURFACING_ENABLED=true
# LLM SPL fallback (advisory only; never bypasses template governance).
AI_SOC_LLM_SPL_FALLBACK_ENABLED=true
# PR #58 — bounded SPL draft for explicit universal/template-free utility authoring only.
AI_SOC_LLM_UTILITY_SPL_DRAFT_ENABLED=true
AI_SOC_LLM_UTILITY_SPL_DRAFT_TIMEOUT_SECONDS=90
AI_SOC_LLM_UTILITY_SPL_DRAFT_FAILOVER_ENABLED=false
AI_SOC_LLM_UTILITY_SKIP_INTENT_ADVISOR=true
# Optional COE generic utility index. Empty means leave universal SPL as <your_index>
# unless user input or source-profile resolution supplies an index.
AI_SOC_UTILITY_SPL_DEFAULT_INDEX=
# Regenerate-once on the SPL failover relevance gate. Default off: one LLM call per
# failover turn (slow on-prem hardware should not pay a second call). Tests opt in.
AI_SOC_LLM_SPL_FAILOVER_RETRY_ENABLED=false
# Optional JSON map for SPL placeholder resolution (Phase H0), e.g.
# {"auth_index":"pgcil_soc","auth_sourcetype":"pgcil:auth"}
AI_SOC_SOURCE_PROFILE_MAP=
# Persisted COE source profile map (Settings → Source Profiles). Empty = backend/data/source_profile_map.json
AI_SOC_SOURCE_PROFILE_STORE_PATH=
# Persisted local asset registry (Settings → Environment Knowledge). Empty = backend/data/asset_registry.json
AI_SOC_ASSET_REGISTRY_STORE_PATH=
# Require analyst confirm-or-update before splunk_run_query executes (after policy gates pass).
AI_SOC_REQUIRE_SPL_EXECUTION_CONFIRMATION=true
# Phase 4/5: curated enrichment activation for runtime evidence/planner paths.
AI_SOC_CURATED_ENRICHMENT_ACTIVATION_ENABLED=true
AI_SOC_LLM_TEMPLATE_MATCH_PROVIDER=
AI_SOC_LLM_TEMPLATE_MATCH_MODEL=
AI_SOC_LLM_TEMPLATE_RENDER_PROVIDER=
AI_SOC_LLM_TEMPLATE_RENDER_MODEL=
AI_SOC_LLM_ROUTE_PLAN_PROVIDER=
AI_SOC_LLM_ROUTE_PLAN_MODEL=
AI_SOC_LLM_ANALYST_SUMMARY_NARRATION_PROVIDER=
AI_SOC_LLM_ANALYST_SUMMARY_NARRATION_MODEL=
AI_SOC_LLM_SHADOW_NARRATION_ENABLED=false
# WS-A CVE snapshot read model (plan §3 A5). Default-off, fail-closed until package vendored.
AI_SOC_CVE_SNAPSHOT_DIR=
AI_SOC_CVE_SNAPSHOT_STALE_AFTER_DAYS=30
# NVD API key for the connected-zone CVE snapshot builder (operator tooling only;
# never read by the air-gapped runtime). Set the real value in .env, never here.
NVD_API_KEY=
# WS-G offline ATT&CK/ATLAS STIX resolver (plan §15 G2). Path vars, not posture flags.
# Unset/missing -> resolver returns None (no technique names), fail-closed.
AI_SOC_ATTACK_STIX_PATH=
AI_SOC_ATLAS_STIX_PATH=
# Offline technique resolver (preferred over STIX when vendored artifacts exist)
AI_SOC_ATTACK_XLSX_PATH=docs/evals/enterprise-attack-v19.1.xlsx
AI_SOC_ATLAS_YAML_PATH=docs/threat-intel/atlas/raw/ATLAS.yaml
IOC_REGISTRY_ENABLED=false
IOC_REGISTRY_PATH=backend/app/intel/fixtures/ioc_registry.sample.json
DETECTION_REGISTRY_ENABLED=false
DETECTION_REGISTRY_PATH=backend/app/detections/fixtures/detection_registry.sample.json
# Provider endpoints. Placeholders only; secrets never surface in status output.
AI_SOC_LLM_OPENAI_BASE_URL=
AI_SOC_LLM_OPENAI_API_KEY=
AI_SOC_LLM_OPENAI_MODEL=
# Local OpenAI-compatible endpoint (dev: Foundation-Sec on host llama-server).
AI_SOC_LLM_LOCAL_BASE_URL=
AI_SOC_LLM_LOCAL_API_KEY=
AI_SOC_LLM_LOCAL_MODEL=
# Operator LLM service control from the UI (privileged; default OFF). The backend
# never touches host systemd: when enabled it writes a control-request sentinel into
# AI_SOC_LLM_CONTROL_DIR (a shared volume) that the HOST watcher
# (scripts/llm_control_watcher.py, run as a systemd service) applies via systemctl.
# Live runtime-health (tok/s) works regardless of this flag.
AI_SOC_LLM_CONTROL_ENABLED=false
AI_SOC_LLM_CONTROL_DIR=/var/lib/ai-soc/llm-control
# COE Qwen — off by default. When true, QWEN_* prepended before LOCAL/Instruct chain.
AI_SOC_LLM_QWEN_PRIMARY_ENABLED=false
AI_SOC_LLM_QWEN_BASE_URL=
AI_SOC_LLM_QWEN_API_KEY=
AI_SOC_LLM_QWEN_MODEL=
# MCP tool-planner: Foundation-Sec Instruct is the planner (1-LLM). Set true to
# append Qwen as a FAILOVER after Instruct (requires AI_SOC_LLM_QWEN_* above).
AI_SOC_LLM_PLANNER_QWEN_FAILOVER_ENABLED=false
# Failover when primary fails or times out.
AI_SOC_LLM_FOUNDATION_SEC_INSTRUCT_BASE_URL=
AI_SOC_LLM_FOUNDATION_SEC_INSTRUCT_API_KEY=
AI_SOC_LLM_FOUNDATION_SEC_INSTRUCT_MODEL=
AI_SOC_LLM_FOUNDATION_SEC_REASONING_BASE_URL=
AI_SOC_LLM_FOUNDATION_SEC_REASONING_API_KEY=
AI_SOC_LLM_FOUNDATION_SEC_REASONING_MODEL=
# Evidence gating for the upcoming synthesis stage.
AI_SOC_LLM_REQUIRE_CONTEXT_SUFFICIENCY=true
AI_SOC_LLM_REQUIRE_SOURCE_REFS=true
AI_SOC_LLM_ALLOW_INSUFFICIENT_EVIDENCE_RESPONSE=false
AI_SOC_LLM_FINAL_SYNTHESIS_ENABLED=false
AI_SOC_LLM_ANSWER_GUARD_ENABLED=false
# Live-chat only: narrate the analyst summary with the real model (requires
# FINAL_SYNTHESIS_ENABLED, a non-mock mode, and a configured endpoint). Facts
# stay deterministic; failure falls back. Experience Center fixtures never call
# a live model. Default false.
# With CONTROL_PLANE_ENABLED=true, Phase 9 governed answer composer uses
# FINAL_SYNTHESIS + LIVE_SYNTHESIS to rewrite direct_answer_summary from the
# enriched AnswerContract only (not the legacy synthesis-lab narration path).
AI_SOC_LLM_LIVE_SYNTHESIS_ENABLED=false
# Phase 2.5 — weak-case composition HIL threshold (0..1). Below this, attach
# analyst_review_required while still rendering the composed body.
AI_SOC_LLM_COMPOSE_HIL_THRESHOLD=0.55

# Stage 3M-S4: Experience Center demo-only LLM shadow (lineage only; default off, no network).
DEMO_LLM_SHADOW_ENABLED=false
DEMO_LLM_SHADOW_PROVIDER=disabled
DEMO_LLM_SHADOW_MODEL=
DEMO_LLM_SHADOW_ENDPOINT=
DEMO_LLM_SHADOW_TIMEOUT_SECONDS=5

# Multi-MCP readiness example. Leave MCP_MODE=mock until COE supplies endpoints.
