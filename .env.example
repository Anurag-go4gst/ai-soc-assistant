ROUTING_MODE=llm_primary
DEBUG_TRACE_ENABLED=true
ROUTING_DETERMINISTIC_THRESHOLD=0.70
ROUTING_LLM_SHADOW_ENABLED=true
ROUTING_COMPARE_LOGGING_ENABLED=true
ROUTE_AUTHORITY_COMPARE_ENABLED=true
ROUTE_AUTHORITY_OPERATION_AUTHORITATIVE_ENABLED=false
ROUTE_AUTHORITY_OPERATION_COVERAGE_ALLOWLIST=

# P0-9 live flow-check profile (documentation/readiness; does not auto-compose env yet).
# When set to stub_evidence, operators still apply the mapping in docs/gap_closure/p0_live_flow_check_profile.md.
# AI_SOC_FLOW_CHECK_MODE=
# Example composed demo (bounded mock MCP — NOT Splunk COE live):
# AI_SOC_FLOW_CHECK_MODE=stub_evidence
# ROUTE_AUTHORITY_COMPARE_ENABLED=true
# ROUTE_AUTHORITY_OPERATION_AUTHORITATIVE_ENABLED=true
# ROUTE_AUTHORITY_OPERATION_COVERAGE_ALLOWLIST=cov.q046
# ROUTING_MODE=llm_assisted_semantic
# RAG_MODE=mock
# MCP_GLOBAL_EXECUTION_ENABLED=true
# MCP_SERVER_MOCK_EXECUTION_ENABLED=true
# AI_SOC_LLM_FINAL_SYNTHESIS_ENABLED=false
# AI_SOC_LLM_ANSWER_GUARD_ENABLED=false

# P5: MITRE candidate mapper sidecar (review-queue only; never authoritative; default off).
# Requires bundle expansion (curated-subset-v2 ships T1110, T1110.001, T1110.003, T1078).
# LLM output is candidate/needs_review trace only; SOC approval required to promote to supported.
AI_SOC_LLM_MITRE_CANDIDATE_MAPPING_ENABLED=false
# AI_SOC_LLM_MITRE_CANDIDATE_PROVIDER=foundation_sec_instruct
# AI_SOC_LLM_MITRE_CANDIDATE_MODEL=Foundation-sec-8B-Instruct

# P1: LangGraph /chat parity (default off; same pipeline stages as imperative path).
LANGGRAPH_ORCHESTRATION_ENABLED=false

# AI-SOC product telemetry sink. Supported today: db | none.
# Planned (not yet implemented; backend will refuse to start): splunk | both.
AI_SOC_TELEMETRY_SINK=db

APP_AUTH_ENABLED=true
APP_AUTH_USER=analyst
APP_AUTH_PASSWORD=
APP_AUTH_SESSION_SECRET=
