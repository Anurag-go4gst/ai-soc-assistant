# Default dev routing: QU-authoritative with LLM advisory (post QU→route_skill bridge).
ROUTING_MODE=llm_assisted_semantic
ROUTING_LAB_LLM_PRIMARY_ENABLED=true
DEBUG_TRACE_ENABLED=true
ROUTING_DETERMINISTIC_THRESHOLD=0.70
ROUTING_LLM_SHADOW_ENABLED=true
ROUTING_COMPARE_LOGGING_ENABLED=true
ROUTE_AUTHORITY_COMPARE_ENABLED=true
ROUTE_AUTHORITY_OPERATION_AUTHORITATIVE_ENABLED=false
ROUTE_AUTHORITY_OPERATION_COVERAGE_ALLOWLIST=
# P2-open / P2-9 / P2-audit (defaults preserve legacy selected_skill authority)
ROUTE_PLAN_OPEN_OPERATIONS_ENABLED=true
LEGACY_SELECTED_SKILL_AUTHORITY_ENABLED=true
ROUTE_PLAN_SUPPORTERS_RUNTIME_ENABLED=true
OPERATION_AUDIT_PERSISTENCE_ENABLED=true

# P0-9 live flow-check profile (documentation/readiness; does not auto-compose env yet).
# When set to stub_evidence, operators still apply the mapping in docs/gap_closure/p0_live_flow_check_profile.md.
# For all safe dev/COE levers ON, copy .env.live-full-throttle.example → .env and set auth secrets.
# For COE live testing (EC parity in /chat + mock MCP + LLM sidecars), use .env.coe-live-testing.example
# and docs/coe/COE_LIVE_TESTING_GUIDE.md.
# AI_SOC_FLOW_CHECK_MODE=
# Example composed demo (bounded mock MCP — NOT Splunk COE live):
# AI_SOC_FLOW_CHECK_MODE=stub_evidence
# ROUTE_AUTHORITY_COMPARE_ENABLED=true
# ROUTE_AUTHORITY_OPERATION_AUTHORITATIVE_ENABLED=true
# Comma-separated manifest coverage_ids (see route_authority_allowlist.manifest_allowlistable_coverage_ids).
# Example pilot: cov.q046.excessive_failed_logins_sample
# Example multi: cov.q046.excessive_failed_logins_sample,cov.q002.top_outbound_source_ips
# ROUTE_AUTHORITY_OPERATION_COVERAGE_ALLOWLIST=cov.q046.excessive_failed_logins_sample
# LEGACY_SELECTED_SKILL_AUTHORITY_ENABLED=false
# ROUTING_MODE=llm_assisted_semantic
# RAG_MODE=mock
# SOC_KB_RETRIEVAL_ENABLED=true
# MCP_GLOBAL_EXECUTION_ENABLED=true
# MCP_SERVER_MOCK_EXECUTION_ENABLED=true
# AI_SOC_LLM_MITRE_CANDIDATE_MAPPING_ENABLED=true
# LANGGRAPH_ORCHESTRATION_ENABLED=true
# AI_SOC_LLM_FINAL_SYNTHESIS_ENABLED=false
# AI_SOC_LLM_ANSWER_GUARD_ENABLED=false

# P5: MITRE candidate mapper sidecar (review-queue only; never authoritative; default off).
# Requires bundle expansion (curated-subset-v2 ships T1110, T1110.001, T1110.003, T1078).
# LLM output is candidate/needs_review trace only; SOC approval required to promote to supported.
AI_SOC_LLM_MITRE_CANDIDATE_MAPPING_ENABLED=false
# AI_SOC_LLM_MITRE_CANDIDATE_PROVIDER=foundation_sec_instruct
# AI_SOC_LLM_MITRE_CANDIDATE_MODEL=Foundation-sec-8B-Instruct

# P1: LangGraph /chat parity (default off; same pipeline stages as imperative path).
LANGGRAPH_ORCHESTRATION_ENABLED=false
# Phase 12: planner-led fan-out/fan-in shadow graph (tests/trace only; default off).
AI_SOC_LANGGRAPH_SHADOW_ENABLED=false

# Safe Phase 9 manual test profile (answer-quality / governed LLM composer):
# Enable: CONTROL_PLANE_ENABLED, AI_SOC_PLANNER_PATH_SELECTION_ENABLED,
#   AI_SOC_LLM_INTENT_ADVISOR_ENABLED, AI_SOC_CURATED_ENRICHMENT_ACTIVATION_ENABLED,
#   AI_SOC_PLANNER_MITRE_BRANCH_ENABLED, AI_SOC_SPL_TEMPLATE_GOVERNANCE_ENABLED,
#   AI_SOC_LLM_FINAL_SYNTHESIS_ENABLED, AI_SOC_LLM_LIVE_SYNTHESIS_ENABLED
# Keep disabled: MCP_GLOBAL_EXECUTION_ENABLED, MCP_SERVER_MOCK_EXECUTION_ENABLED,
#   LANGGRAPH_ORCHESTRATION_ENABLED (planner-led fan-out/fan-in graph not yet implemented),
#   AI_SOC_LLM_SPL_FALLBACK_ENABLED
# Also configure a local/openai-compatible endpoint (AI_SOC_LLM_LOCAL_BASE_URL) for live synthesis.
# Do not use REAL_SPLUNK_MCP_ENABLED or SPL_EXECUTION_ENABLED — those are not repo env vars.
# Full cutover profiles: docs/demo/flag_cutover_matrix.md
# Manual demo checklist: docs/demo/demo_scenarios_readiness.md

# AI-SOC product telemetry sink. Supported today: db | none.
# Planned (not yet implemented; backend will refuse to start): splunk | both.
AI_SOC_TELEMETRY_SINK=db

APP_AUTH_ENABLED=true
APP_AUTH_USER=analyst
APP_AUTH_PASSWORD=
APP_AUTH_SESSION_SECRET=
