# =============================================================================
# COE live testing profile — copy to operator-local `.env` and fill secrets.
# See docs/coe/COE_LIVE_TESTING_GUIDE.md for what flags do vs what still needs code.
# =============================================================================

APP_ENV=development
BACKEND_PORT=8010
FRONTEND_PORT=3010
DATABASE_URL=postgresql://ai_soc:ai_soc_dev_password@postgres:5432/ai_soc_assistant
AI_SOC_ENVIRONMENT_MODE=coe
DEBUG_TRACE_ENABLED=true

# --- App auth (set password + session secret locally; never commit) ---
APP_AUTH_ENABLED=true
APP_AUTH_USER=analyst
APP_AUTH_PASSWORD=
APP_AUTH_SESSION_SECRET=

# --- Profile labels ---
# stub_evidence = documented COE system-check (see docs/gap_closure/p0_live_flow_check_profile.md)
AI_SOC_FLOW_CHECK_MODE=stub_evidence

# =============================================================================
# A) Experience Center parity in /chat (same cards as scenario picker)
# =============================================================================
# When true, typing the EXACT Experience Center scenario query in live chat returns
# the same governed demo payload (fixtures). Required for "EC looks like live chat"
# until real Splunk MCP adapter ships.
AI_SOC_LIVE_CHAT_EC_PARITY_ENABLED=true

# =============================================================================
# B) Chat control plane (intent → evidence_plan → MCP allow/deny)
# =============================================================================
CONTROL_PLANE_ENABLED=true
LANGGRAPH_ORCHESTRATION_ENABLED=true

# =============================================================================
# C) MCP — Phase 1: mock execution (bounded rows; NOT real Splunk yet)
# =============================================================================
MCP_MODE=mock
MCP_DEFAULT_SERVER=splunk_soc
MCP_GLOBAL_EXECUTION_ENABLED=true
MCP_SERVER_MOCK_EXECUTION_ENABLED=true

# Answer-quality ledger + reviewer UI
QUALITY_REVIEW_ENABLED=true
QUALITY_REVIEW_ALLOW_ANY_AUTHENTICATED=true

# --- Phase 2: real Splunk MCP (registry) — configure when COE supplies contract ---
# CODE STILL BLOCKS: mcp_execution_gate returns real_mcp_adapter_not_implemented
# until splunk_mcp.py adapter is implemented (see plans/2026-05-30_1845_query-to-answer-live-mcp-llm-readiness.md).
#
# MCP_MODE=registry
# MCP_SERVERS=splunk_soc
# MCP_SERVER_SPLUNK_SOC_ENABLED=true
# MCP_SERVER_SPLUNK_SOC_TYPE=splunk
# MCP_SERVER_SPLUNK_SOC_TRANSPORT=streamable_http
# MCP_SERVER_SPLUNK_SOC_URL=https://REPLACE-WITH-COE-SPLUNK-MCP-URL/mcp
# MCP_SERVER_SPLUNK_SOC_AUTH_MODE=bearer
# MCP_SERVER_SPLUNK_SOC_BEARER_TOKEN=REPLACE-WITH-TOKEN
# MCP_SERVER_SPLUNK_SOC_CONNECT_TIMEOUT_SECONDS=30
# MCP_SERVER_SPLUNK_SOC_TOOL_ALLOWLIST=run_splunk_query,splunk_get_indexes,splunk_get_metadata
# MCP_SERVER_SPLUNK_SOC_EXECUTION_ENABLED=true
# MCP_SERVER_SPLUNK_SOC_SPLUNK_APP_ID=7931
# MCP_SERVER_SPLUNK_SOC_SPLUNK_PLATFORM=splunk_enterprise

# Legacy Splunk MCP placeholders (status/discovery hints)
SPLUNK_MCP_ENABLED=true
SPLUNK_MCP_BASE_URL=
SPLUNK_MCP_TOKEN=
SPLUNK_MCP_SERVER_ID=splunk_soc
SPLUNK_MCP_DISCOVERY_MODE=dynamic
SPLUNK_ALLOW_RUN_SAVED_SEARCH=false
SPLUNK_RUN_QUERY_REQUIRE_VALIDATION=true

# =============================================================================
# D) Governed SOC-KB RAG (fixture corpus in repo; not customer Splunk KB)
# =============================================================================
RAG_MODE=mock
SOC_KB_RETRIEVAL_ENABLED=true
SOC_KB_ENVIRONMENT=coe
SOC_KB_RERANKER_ENABLED=false
SOC_KB_LLM_AMBIGUITY_ASSIST_ENABLED=false

# =============================================================================
# E) LLM registry + routing (advisory sidecars; fill endpoints in local .env)
# =============================================================================
LLM_MODE=mock
LLM_ENABLED=true
LLM_HEALTH_CANARY_ENABLED=true
LLM_TOOL_RECOMMENDATION_ENABLED=false

AI_SOC_LLM_ENABLED=true
AI_SOC_LLM_MODE=cisco_foundation_sec
AI_SOC_LLM_ALLOW_CLOUD=true
AI_SOC_LLM_AIRGAP_ENFORCED=false

# Fill with COE Foundation-sec / gateway endpoints (secrets stay local):
AI_SOC_LLM_FOUNDATION_SEC_INSTRUCT_BASE_URL=
AI_SOC_LLM_FOUNDATION_SEC_INSTRUCT_API_KEY=
AI_SOC_LLM_FOUNDATION_SEC_INSTRUCT_MODEL=Foundation-sec-8B-Instruct
AI_SOC_LLM_FOUNDATION_SEC_REASONING_BASE_URL=
AI_SOC_LLM_FOUNDATION_SEC_REASONING_API_KEY=
AI_SOC_LLM_FOUNDATION_SEC_REASONING_MODEL=Foundation-sec-8B-Reasoning

AI_SOC_LLM_ROLE_SYNTHESIS_PROVIDER=foundation_sec_instruct
AI_SOC_LLM_ROLE_SYNTHESIS_MODEL=Foundation-sec-8B-Instruct
AI_SOC_LLM_ROLE_REASONING_PROVIDER=foundation_sec_reasoning
AI_SOC_LLM_ROLE_REASONING_MODEL=Foundation-sec-8B-Reasoning
AI_SOC_LLM_ROUTE_PLAN_PROVIDER=foundation_sec_instruct
AI_SOC_LLM_ROUTE_PLAN_MODEL=Foundation-sec-8B-Instruct
AI_SOC_LLM_INTENT_PROVIDER=foundation_sec_instruct
AI_SOC_LLM_INTENT_MODEL=Foundation-sec-8B-Instruct
AI_SOC_LLM_MITRE_CANDIDATE_MAPPING_ENABLED=true
AI_SOC_LLM_MITRE_CANDIDATE_PROVIDER=foundation_sec_instruct
AI_SOC_LLM_MITRE_CANDIDATE_MODEL=Foundation-sec-8B-Instruct

# P6 synthesis lab (deterministic draft from evidence — NOT live model prose yet)
AI_SOC_LLM_FINAL_SYNTHESIS_ENABLED=true
AI_SOC_LLM_ANSWER_GUARD_ENABLED=true

# Multi-provider registry (optional; uncomment and fill per provider)
# LLM_PROVIDERS=foundation_sec_instruct,foundation_sec_reasoning
# LLM_DEFAULT_PROVIDER=foundation_sec_instruct
# LLM_ROUTER_PROVIDER=foundation_sec_instruct
# LLM_SYNTHESIS_PROVIDER=foundation_sec_instruct
# LLM_REASONING_PROVIDER=foundation_sec_reasoning

ROUTING_MODE=llm_assisted_semantic
ROUTING_LAB_LLM_PRIMARY_ENABLED=true
ROUTING_LLM_SHADOW_ENABLED=true
ROUTING_COMPARE_LOGGING_ENABLED=true
ROUTING_DETERMINISTIC_THRESHOLD=0.70
ROUTE_AUTHORITY_COMPARE_ENABLED=true
ROUTE_AUTHORITY_OPERATION_AUTHORITATIVE_ENABLED=true
ROUTE_AUTHORITY_OPERATION_COVERAGE_ALLOWLIST=cov.q046.excessive_failed_logins_sample
LEGACY_SELECTED_SKILL_AUTHORITY_ENABLED=false
ROUTE_PLAN_OPEN_OPERATIONS_ENABLED=true
ROUTE_PLAN_SUPPORTERS_RUNTIME_ENABLED=true
OPERATION_AUDIT_PERSISTENCE_ENABLED=true

# Legacy LLM URLs (optional if using AI_SOC_LLM_* above)
FOUNDATION_SEC_INSTRUCT_URL=
FOUNDATION_SEC_REASONING_URL=
REASONING_ENABLED=true

# =============================================================================
# F) SPL policy (align with COE Splunk indexes/sourcetypes)
# =============================================================================
SPL_VALIDATION_ENABLED=true
SPL_ALLOWED_INDEXES=pgcil_soc
SPL_ALLOWED_SOURCETYPES=pgcil:auth,aws:cloudtrail
SPL_DEFAULT_EARLIEST=-60m
SPL_DEFAULT_LATEST=now
SPL_MAX_RESULT_LIMIT=100
SPL_ALLOWED_COMMANDS=search,stats,where,table,fields,sort,dedup,rename,eval,timechart,bin,head
SPL_BLOCKED_COMMANDS=delete,collect,outputlookup,sendemail,script,map,rest,loadjob,inputlookup

# =============================================================================
# G) Telemetry / embeddings
# =============================================================================
TELEMETRY_MODE=db
AI_SOC_TELEMETRY_SINK=db
EMBEDDINGS_MODE=mock

# =============================================================================
# H) Registries (optional local IOC/detection fixtures)
# =============================================================================
IOC_REGISTRY_ENABLED=true
IOC_REGISTRY_PATH=backend/app/intel/fixtures/ioc_registry.sample.json
DETECTION_REGISTRY_ENABLED=true
DETECTION_REGISTRY_PATH=backend/app/detections/fixtures/detection_registry.sample.json

# SAIA tools discoverable but blocked from execution gate (by design)
SPLUNK_AI_ASSISTANT_MODE=auto
SPLUNK_SAIA_TOOLS_ENABLED=true
SPLUNK_USE_SAIA_GENERATE_SPL=true
SPLUNK_USE_SAIA_EXPLAIN_SPL=true
SPLUNK_USE_SAIA_OPTIMIZE_SPL=true
SPLUNK_USE_SAIA_ASK_QUESTION=true
