# ==========================================================================
# .env.splunk-live.example — GO-LIVE flag set for real Splunk MCP search.
#
# Purpose: at go-live the ONLY pending action is supplying credentials.
#   1. cp .env.splunk-live.example .env
#   2. set SPLUNK_MCP_BASE_URL and SPLUNK_MCP_TOKEN (the two blanks below)
#   3. align SPL_ALLOWED_INDEXES / SPL_ALLOWED_SOURCETYPES to the deployment
#   4. flip contracts/splunk_mcp_connection_contract.md schema_confirmed=true
#      after a staging smoke test (operator sign-off; no external COE)
#   5. restart backend — NO code change
#
# Every flag here is at its live value. .env.example stays default-off (safe for
# clones); this file is the live overlay. Decisions: A.13 in
# plans/2026-05-30_1845_query-to-answer-live-mcp-llm-readiness.md
# ==========================================================================

APP_ENV=production
BACKEND_PORT=8010
FRONTEND_PORT=3010
DATABASE_URL=postgresql://ai_soc:change-me@postgres:5432/ai_soc_assistant

# --- Live MCP (Splunk) execution ------------------------------------------
# registry mode + a configured Splunk endpoint routes to the real connector.
MCP_MODE=registry
MCP_DEFAULT_SERVER=splunk_soc
MCP_SERVERS=splunk_soc
MCP_GLOBAL_EXECUTION_ENABLED=true
# Mock execution stays OFF in live (this is real Splunk, not fixtures).
MCP_SERVER_MOCK_EXECUTION_ENABLED=false
MCP_DISCOVERY_ENABLED=true
# Real successful searches still require analyst review by default.
AI_SOC_REQUIRE_HIL_FOR_MOCK_EXECUTION=true
AI_SOC_ALLOW_MOCK_EXECUTION_WITHOUT_HIL_IN_DEMO=false
AI_SOC_DEMO_OR_LAB_EXECUTION_MODE=false

# Splunk MCP server (Go-live decision A.13: service-account bearer token).
SPLUNK_MCP_ENABLED=true
SPLUNK_MCP_SERVER_ID=splunk_soc
SPLUNK_MCP_BASE_URL=
SPLUNK_MCP_TOKEN=
MCP_SERVER_SPLUNK_SOC_ENABLED=true
MCP_SERVER_SPLUNK_SOC_TYPE=splunk
MCP_SERVER_SPLUNK_SOC_TRANSPORT=streamable_http
MCP_SERVER_SPLUNK_SOC_URL=
MCP_SERVER_SPLUNK_SOC_AUTH_MODE=bearer
MCP_SERVER_SPLUNK_SOC_BEARER_TOKEN=
MCP_SERVER_SPLUNK_SOC_EXECUTION_ENABLED=true
MCP_SERVER_SPLUNK_SOC_TOOL_ALLOWLIST=splunk_run_query,splunk_get_info,splunk_get_indexes,splunk_get_index_info,splunk_get_metadata,splunk_get_user_info,splunk_get_knowledge_objects

# Async search job lifecycle bounds (connector-internal; one logical call).
MCP_MAX_POLLS_PER_CALL=60
MCP_SEARCH_JOB_TIMEOUT_MS=120000
MCP_SEARCH_POLL_INTERVAL_MS=2000

# --- SPL policy (align to the live Splunk deployment) ---------------------
SPL_VALIDATION_ENABLED=true
SPL_ALLOWED_INDEXES=pgcil_soc
SPL_ALLOWED_SOURCETYPES=pgcil:auth,aws:cloudtrail,pgcil:edr,pgcil:dns
SPL_DEFAULT_EARLIEST=-24h
SPL_DEFAULT_LATEST=now
SPL_MAX_RESULT_LIMIT=100
SPL_ALLOWED_COMMANDS=search,stats,where,table,fields,sort,dedup,rename,eval,timechart,bin,head,streamstats
SPL_BLOCKED_COMMANDS=delete,collect,outputlookup,sendemail,script,map,rest,loadjob,inputlookup

# --- Governed adaptive search (broaden-on-empty) --------------------------
# LLM proposes a broadened query on an empty primary; validated + HIL-approved.
AI_SOC_LLM_SPL_FALLBACK_ENABLED=true
AI_SOC_REQUIRE_SPL_EXECUTION_CONFIRMATION=true
AI_SOC_SPL_TEMPLATE_GOVERNANCE_ENABLED=true
AI_SOC_SPL_DRAFT_PREVIEW_ENABLED=true
AI_SOC_SOURCE_PROFILE_MAP=
AI_SOC_SOURCE_PROFILE_STORE_PATH=

# --- Control plane / planner (live SOC posture) ---------------------------
CONTROL_PLANE_ENABLED=true
AI_SOC_PLANNER_PATH_SELECTION_ENABLED=true
AI_SOC_PLANNER_MITRE_BRANCH_ENABLED=true
AI_SOC_LLM_INTENT_ADVISOR_ENABLED=true
AI_SOC_CURATED_ENRICHMENT_ACTIVATION_ENABLED=true
AI_SOC_SESSION_CONTEXT_ENABLED=true
AI_SOC_SESSION_CONTEXT_TTL_MINUTES=30
ROUTING_MODE=llm_assisted_semantic
ROUTING_LAB_LLM_PRIMARY_ENABLED=true
LANGGRAPH_ORCHESTRATION_ENABLED=false

# --- LLM (configure a real endpoint to enable live narration) -------------
# Facts stay deterministic; the model only rewrites prose. Leave mock/false to
# run deterministic answers; set mode=local + an endpoint to narrate live.
RAG_MODE=mock
LLM_MODE=mock
AI_SOC_LLM_ENABLED=false
AI_SOC_LLM_MODE=mock
AI_SOC_LLM_FINAL_SYNTHESIS_ENABLED=false
AI_SOC_LLM_LIVE_SYNTHESIS_ENABLED=false
AI_SOC_LLM_ANSWER_GUARD_ENABLED=false
AI_SOC_LLM_LOCAL_BASE_URL=
AI_SOC_LLM_LOCAL_API_KEY=
AI_SOC_LLM_LOCAL_MODEL=

# --- Telemetry + auth -----------------------------------------------------
TELEMETRY_MODE=db
AI_SOC_TELEMETRY_SINK=db
DEBUG_TRACE_ENABLED=false
APP_AUTH_ENABLED=true
APP_AUTH_USER=analyst
APP_AUTH_PASSWORD=
APP_AUTH_SESSION_SECRET=
