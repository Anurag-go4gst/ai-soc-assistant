# =============================================================================
# AI-SOC environment profile: COE (Velocis LAN)
# =============================================================================
# Loaded when AI_SOC_ENV_PROFILE=coe (see env/README.md).
# Operator secrets (APP_AUTH_PASSWORD, APP_AUTH_SESSION_SECRET, NVD_API_KEY,
# SPLUNK_MCP_TOKEN) belong in the repo-root .env — they override this file.
#
# LLM smoke-verified 2026-06-29:
#   Base URL: http://10.52.1.13:8002/v1
#   Model ID: foundation-sec-8b-reasoning
#   max_model_len: 16384 (vLLM)
# =============================================================================

APP_ENV=development
BACKEND_PORT=8010
FRONTEND_PORT=3010
DATABASE_URL=postgresql://ai_soc:ai_soc_dev_password@postgres:5432/ai_soc_assistant
AI_SOC_ENVIRONMENT_MODE=coe
DEBUG_TRACE_ENABLED=true

# --- Deployment profile marker (read by Settings → Deployment) ---
AI_SOC_ENV_PROFILE=coe

# --- App auth: set password + session secret in repo-root .env only ---
APP_AUTH_ENABLED=true
APP_AUTH_USER=analyst
APP_AUTH_ROLE=demo_analyst
APP_AUTH_PASSWORD=
APP_AUTH_SESSION_SECRET=

# =============================================================================
# Control plane + planner (COE lab full planner path)
# =============================================================================
CONTROL_PLANE_ENABLED=true
# Guided hybrid Batch 1 — requires CONTROL_PLANE_ENABLED=true (see plans/LOOP_RUNNER_guided-hybrid-investigation.md)
AI_SOC_GUIDED_HYBRID_INVESTIGATION_ENABLED=true
AI_SOC_PIPELINE_DISPATCH_V2_ENABLED=false
AI_SOC_PLANNER_PATH_SELECTION_ENABLED=true
AI_SOC_PLANNER_MITRE_BRANCH_ENABLED=true
AI_SOC_SPL_TEMPLATE_GOVERNANCE_ENABLED=true
AI_SOC_SPL_DRAFT_PREVIEW_ENABLED=true
AI_SOC_CURATED_ENRICHMENT_ACTIVATION_ENABLED=true
AI_SOC_FLOW_CHECK_MODE=stub_evidence
AI_SOC_LIVE_CHAT_EC_PARITY_ENABLED=false
# Hybrid rail uses imperative pipeline.py; LangGraph not required for Batch 1
LANGGRAPH_ORCHESTRATION_ENABLED=false
AI_SOC_LANGGRAPH_SHADOW_ENABLED=false

# Session pins
AI_SOC_SESSION_CONTEXT_ENABLED=true
AI_SOC_SESSION_CONTEXT_TTL_MINUTES=30

# Answer-quality ledger
QUALITY_REVIEW_ENABLED=true
QUALITY_REVIEW_USER_ALLOWLIST=
QUALITY_REVIEW_ALLOW_ANY_AUTHENTICATED=true

# =============================================================================
# Routing / authority
# =============================================================================
ROUTING_MODE=llm_assisted_semantic
ROUTING_LAB_LLM_PRIMARY_ENABLED=true
ROUTING_DETERMINISTIC_THRESHOLD=0.70
ROUTING_LLM_SHADOW_ENABLED=true
ROUTING_COMPARE_LOGGING_ENABLED=true
ROUTE_AUTHORITY_COMPARE_ENABLED=true
ROUTE_AUTHORITY_OPERATION_AUTHORITATIVE_ENABLED=true
ROUTE_AUTHORITY_OPERATION_COVERAGE_ALLOWLIST=cov.q046.excessive_failed_logins_sample,cov.q002.top_outbound_source_ips
LEGACY_SELECTED_SKILL_AUTHORITY_ENABLED=false
ROUTE_PLAN_OPEN_OPERATIONS_ENABLED=true
ROUTE_PLAN_SUPPORTERS_RUNTIME_ENABLED=true
OPERATION_AUDIT_PERSISTENCE_ENABLED=true

# =============================================================================
# RAG / SOC-KB (fixture corpus)
# =============================================================================
RAG_MODE=mock
SOC_KB_RETRIEVAL_ENABLED=true
SOC_KB_RETRIEVAL_MODE=deterministic
SOC_KB_REPOSITORY_BACKEND=json
SOC_KB_VECTOR_BACKEND=none
SOC_KB_ENVIRONMENT=coe
SOC_KB_RERANKER_ENABLED=true
SOC_KB_RERANKER_PROVIDER=mock
SOC_KB_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
SOC_KB_RERANKER_TIMEOUT_SECONDS=10
SOC_KB_RERANKER_TOP_N=5
SOC_KB_LLM_AMBIGUITY_ASSIST_ENABLED=true
SOC_KB_LLM_AMBIGUITY_MAX_CANDIDATES=5
SOC_KB_GRAPH_EXPANSION_ENABLED=true
SOC_KB_HYBRID_PLACEHOLDER_ENABLED=true
SOC_KB_GRAPH_PLACEHOLDER_ENABLED=true
SOC_KB_DIRECT_TO_LLM=false

# =============================================================================
# MCP — discovery only for Batch 1 (no mock/live execution)
# Guided hybrid Batch 1: safe_spl_execution_allowed stays false in code; keep exec flags off.
# =============================================================================
MCP_MODE=mock
MCP_DEFAULT_SERVER=splunk_soc
MCP_GLOBAL_EXECUTION_ENABLED=false
MCP_SERVER_MOCK_EXECUTION_ENABLED=false
MCP_DISCOVERY_ENABLED=true
MCP_MAX_POLLS_PER_CALL=60
MCP_SEARCH_JOB_TIMEOUT_MS=120000
MCP_SEARCH_POLL_INTERVAL_MS=2000
AI_SOC_REQUIRE_HIL_FOR_MOCK_EXECUTION=true
AI_SOC_ALLOW_MOCK_EXECUTION_WITHOUT_HIL_IN_DEMO=true
AI_SOC_DEMO_OR_LAB_EXECUTION_MODE=false
AI_SOC_REQUIRE_SPL_EXECUTION_CONFIRMATION=true

# Live Splunk MCP (uncomment when COE supplies URL + token in root .env)
# MCP_MODE=registry
# MCP_SERVERS=splunk_soc
# MCP_SERVER_SPLUNK_SOC_ENABLED=true
# MCP_SERVER_SPLUNK_SOC_TYPE=splunk
# MCP_SERVER_SPLUNK_SOC_TRANSPORT=streamable_http
# MCP_SERVER_SPLUNK_SOC_URL=https://REPLACE-WITH-COE-SPLUNK-MCP-URL/mcp
# MCP_SERVER_SPLUNK_SOC_AUTH_MODE=bearer
# MCP_SERVER_SPLUNK_SOC_BEARER_TOKEN=
# MCP_SERVER_SPLUNK_SOC_EXECUTION_ENABLED=false
# MCP_SERVER_SPLUNK_SOC_TOOL_ALLOWLIST=splunk_run_query,splunk_get_info,splunk_get_indexes,splunk_get_index_info,splunk_get_metadata,splunk_get_user_info,splunk_get_knowledge_objects

SPLUNK_MCP_ENABLED=true
SPLUNK_MCP_BASE_URL=
SPLUNK_MCP_TOKEN=
SPLUNK_MCP_SERVER_ID=splunk_soc
SPLUNK_MCP_DISCOVERY_MODE=dynamic
SPLUNK_AI_ASSISTANT_MODE=auto
SPLUNK_SAIA_TOOLS_ENABLED=true
SPLUNK_USE_SAIA_GENERATE_SPL=true
SPLUNK_USE_SAIA_EXPLAIN_SPL=true
SPLUNK_USE_SAIA_OPTIMIZE_SPL=true
SPLUNK_USE_SAIA_ASK_QUESTION=true
SPLUNK_SAIA_REQUIRE_DISCOVERY=true
SPLUNK_ALLOW_RUN_SAVED_SEARCH=false
SPLUNK_RUN_SAVED_SEARCH_REQUIRE_HIL=true
SPLUNK_RUN_QUERY_REQUIRE_VALIDATION=true
SPLUNK_METADATA_DISCOVERY_ALLOWED=true
SPLUNK_KNOWLEDGE_OBJECT_DISCOVERY_ALLOWED=true
SPLUNK_ALLOWED_CORE_TOOLS=splunk_run_query,splunk_get_info,splunk_get_indexes,splunk_get_index_info,splunk_get_metadata,splunk_get_user_info,splunk_get_knowledge_objects
SPLUNK_ALLOWED_SAIA_TOOLS=saia_generate_spl,saia_explain_spl,saia_optimize_spl,saia_ask_splunk_question

# =============================================================================
# SPL policy (PowerGrid / PGCIL)
# =============================================================================
SPL_VALIDATION_ENABLED=true
SPL_ALLOWED_INDEXES=pgcil_soc,scada_perf,cisco_asa
SPL_ALLOWED_SOURCETYPES=pgcil:auth,aws:cloudtrail,pgcil:edr,pgcil:dns,pgcil:firewall,pgcil:vpn,pgcil:network,WinEventLog:Security,XmlWinEventLog:Microsoft-Windows-Sysmon/Operational,cisco:firepower,cisco:ise,cisco:ios,cisco:stealthwatch,cisco:tacacs,cisco:wlc,cisco:duo,cisco:amp,ot:auth,ot:modbus,ot:dnp3,ot:scada,ot:pmu,ot:meter,ot:firewall
SPL_DEFAULT_EARLIEST=-24h
SPL_DEFAULT_LATEST=now
SPL_MAX_RESULT_LIMIT=100
SPL_ALLOWED_COMMANDS=search,stats,where,table,fields,sort,dedup,rename,eval,timechart,bin,bucket,head,streamstats,iplocation,mvexpand
SPL_BLOCKED_COMMANDS=delete,collect,outputlookup,sendemail,script,map,rest,loadjob,inputlookup
SPL_ALLOWED_LOOKUPS=power_sector_iocs.csv,ot_asset_inventory.csv,ot_assets.csv,cii_registry.csv,cert_in_ioc.csv,master_stations.csv,physical_access.csv
SPL_ALLOW_JOIN_IN_GOVERNED_TEMPLATES=true
SPL_ALLOW_TRANSACTION_IN_GOVERNED_TEMPLATES=true

AI_SOC_SOURCE_PROFILE_MAP={"auth_index":"pgcil_soc","windows_index":"pgcil_soc","network_index":"pgcil_soc","dns_index":"pgcil_soc","endpoint_index":"pgcil_soc","firewall_index":"pgcil_soc","vpn_index":"pgcil_soc","sysmon_index":"pgcil_soc","notable_index":"pgcil_soc","scada_index":"pgcil_soc","cisco_firewall_index":"pgcil_soc","auth_sourcetype":"pgcil:auth","windows_security_sourcetype":"WinEventLog:Security","dns_sourcetype":"pgcil:dns","endpoint_process_sourcetype":"pgcil:edr","network_traffic_sourcetype":"pgcil:network","firewall_sourcetype":"pgcil:firewall","vpn_sourcetype":"pgcil:vpn","scada_sourcetype":"ot:scada","cisco_firewall_sourcetype":"cisco:firepower"}
AI_SOC_TEMPLATE_ENV_BINDING_ENABLED=true
AI_SOC_SOURCE_PROFILE_STORE_PATH=
AI_SOC_ASSET_REGISTRY_STORE_PATH=

# =============================================================================
# LLM — COE Foundation-Sec 8B reasoning (vLLM @ 10.52.1.13:8002)
# =============================================================================
LLM_MODE=mock
LLM_ENABLED=true
LLM_HEALTH_CANARY_ENABLED=true
LLM_TOOL_RECOMMENDATION_ENABLED=false
FOUNDATION_SEC_INSTRUCT_URL=
FOUNDATION_SEC_REASONING_URL=
REASONING_ENABLED=true

AI_SOC_LLM_ENABLED=true
AI_SOC_LLM_MODE=local
AI_SOC_LLM_ALLOW_CLOUD=false
AI_SOC_LLM_AIRGAP_ENFORCED=true
AI_SOC_LLM_DEFAULT_PROVIDER=local
AI_SOC_LLM_DEFAULT_MODEL=foundation-sec-8b-reasoning

AI_SOC_LLM_ACTIVE_MODEL=foundation-sec-8b-reasoning
AI_SOC_LLM_AVAILABLE_MODELS=foundation-sec-8b-reasoning

AI_SOC_LLM_TIMEOUT_SECONDS=120
AI_SOC_LLM_INTENT_ADVISOR_RESERVE_SECONDS=20
AI_SOC_LLM_TURN_DEADLINE_SECONDS=120
AI_SOC_LLM_T2_INTENT_ADVISOR_BOUND_SECONDS=90
AI_SOC_LLM_T2_TURN_DEADLINE_SECONDS=120
AI_SOC_LLM_MAX_INPUT_TOKENS=12000
AI_SOC_LLM_MAX_OUTPUT_TOKENS=1024
AI_SOC_LLM_TEMPERATURE=0.2
AI_SOC_LLM_STREAMING=false
AI_SOC_LLM_LOG_PROMPTS=false
AI_SOC_LLM_LOG_RESPONSES=false
AI_SOC_LLM_REDACT_SECRETS=true

# Primary — COE vLLM (OpenAI-compatible, no auth)
AI_SOC_LLM_LOCAL_BASE_URL=http://10.52.1.13:8002/v1
AI_SOC_LLM_LOCAL_API_KEY=not-needed
AI_SOC_LLM_LOCAL_MODEL=foundation-sec-8b-reasoning

# Reasoning sidecars (same endpoint until separate instruct port exists)
AI_SOC_LLM_FOUNDATION_SEC_REASONING_BASE_URL=http://10.52.1.13:8002/v1
AI_SOC_LLM_FOUNDATION_SEC_REASONING_API_KEY=not-needed
AI_SOC_LLM_FOUNDATION_SEC_REASONING_MODEL=foundation-sec-8b-reasoning

# Optional Qwen 72B failover (off by default)
AI_SOC_LLM_QWEN_PRIMARY_ENABLED=false
AI_SOC_LLM_QWEN_BASE_URL=http://10.52.1.13:8000/v1
AI_SOC_LLM_QWEN_API_KEY=not-needed
AI_SOC_LLM_QWEN_MODEL=./qwen72b
AI_SOC_LLM_PLANNER_QWEN_FAILOVER_ENABLED=false

# Instruct failover — leave unset until COE provides a separate instruct endpoint
AI_SOC_LLM_FOUNDATION_SEC_INSTRUCT_BASE_URL=
AI_SOC_LLM_FOUNDATION_SEC_INSTRUCT_API_KEY=
AI_SOC_LLM_FOUNDATION_SEC_INSTRUCT_MODEL=

AI_SOC_LLM_INTENT_ADVISOR_ENABLED=true
AI_SOC_LLM_SPL_FALLBACK_ENABLED=true
AI_SOC_LLM_UTILITY_SPL_DRAFT_ENABLED=true
AI_SOC_LLM_UTILITY_SPL_DRAFT_TIMEOUT_SECONDS=90
AI_SOC_LLM_UTILITY_SPL_DRAFT_FAILOVER_ENABLED=false
AI_SOC_LLM_UTILITY_SKIP_INTENT_ADVISOR=true
AI_SOC_LLM_SPL_FAILOVER_RETRY_ENABLED=false
AI_SOC_LLM_MITRE_CANDIDATE_MAPPING_ENABLED=true

AI_SOC_LLM_REQUIRE_CONTEXT_SUFFICIENCY=true
AI_SOC_LLM_REQUIRE_SOURCE_REFS=true
AI_SOC_LLM_ALLOW_INSUFFICIENT_EVIDENCE_RESPONSE=true
AI_SOC_LLM_FINAL_SYNTHESIS_ENABLED=true
AI_SOC_LLM_ANSWER_GUARD_ENABLED=true
AI_SOC_LLM_LIVE_SYNTHESIS_ENABLED=true
AI_SOC_LLM_SHADOW_NARRATION_ENABLED=true
AI_SOC_LLM_COMPOSE_HIL_THRESHOLD=0.55

AI_SOC_LLM_CONTROL_ENABLED=false
AI_SOC_LLM_CONTROL_DIR=/var/lib/ai-soc/llm-control

# T2 answer-shape (PowerGrid)
AI_SOC_T2_ANSWER_SHAPE_ENABLED=true
AI_SOC_T2_ANSWER_SURFACING_ENABLED=true
AI_SOC_T2_RAG_SURFACING_ENABLED=true

# =============================================================================
# Telemetry / observability / debug
# =============================================================================
TELEMETRY_MODE=db
AI_SOC_TELEMETRY_SINK=db
AI_SOC_TELEMETRY_FILE_DIR=telemetry_logs
EMBEDDINGS_MODE=mock
AI_SOC_DEBUG_API_ENABLED=true
AI_SOC_DEBUG_API_USER_ALLOWLIST=
AI_SOC_DEBUG_API_ALLOW_ANY_AUTHENTICATED=false

# =============================================================================
# Intel / CVE / offline resolvers
# =============================================================================
IOC_REGISTRY_ENABLED=true
IOC_REGISTRY_PATH=backend/app/intel/fixtures/ioc_registry.sample.json
DETECTION_REGISTRY_ENABLED=true
DETECTION_REGISTRY_PATH=backend/app/detections/fixtures/detection_registry.sample.json
AI_SOC_CVE_SNAPSHOT_DIR=
AI_SOC_CVE_SNAPSHOT_STALE_AFTER_DAYS=30
NVD_API_KEY=
AI_SOC_ATTACK_STIX_PATH=
AI_SOC_ATLAS_STIX_PATH=
AI_SOC_ATTACK_XLSX_PATH=docs/evals/enterprise-attack-v19.1.xlsx
AI_SOC_ATLAS_YAML_PATH=docs/threat-intel/atlas/raw/ATLAS.yaml

# =============================================================================
# Experience Center demo shadows
# =============================================================================
DEMO_LLM_SHADOW_ENABLED=false
DEMO_LLM_SHADOW_PROVIDER=disabled
DEMO_LLM_SHADOW_MODEL=
DEMO_LLM_SHADOW_ENDPOINT=
DEMO_LLM_SHADOW_TIMEOUT_SECONDS=5
