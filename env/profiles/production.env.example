# Production profile scaffold (fill values for COE production handoff)
# Copy this to a secure operator-managed file and apply secrets there.
APP_ENV=production
AI_SOC_ENV_PROFILE=production

# Preserve fail-closed defaults unless explicitly approved.
CONTROL_PLANE_ENABLED=true
AI_SOC_PIPELINE_DISPATCH_V2_ENABLED=false
MCP_GLOBAL_EXECUTION_ENABLED=false
MCP_SERVER_MOCK_EXECUTION_ENABLED=false

# -----------------------------------------------------------------------------
# LLM budget block — sized for ~6000 tok/s production throughput
# See docs/architecture/llm_budget_model.md for per-hop reserves and skip order.
# Restart backend after edits.
# -----------------------------------------------------------------------------
AI_SOC_LLM_TURN_DEADLINE_SECONDS=90
AI_SOC_LLM_TIMEOUT_SECONDS=25
AI_SOC_LLM_MAX_OUTPUT_TOKENS=1024
AI_SOC_LLM_INTENT_ADVISOR_RESERVE_SECONDS=5
AI_SOC_GUIDED_LLM_MAX_CALLS=5
AI_SOC_GUIDED_LLM_TIMEOUT_SECONDS=90
AI_SOC_GUIDED_LLM_MIN_FINAL_RESERVE_SECONDS=15

# DG-5: catalogue-known auto-execute (default off until COE pilot)
AI_SOC_CATALOGUE_AUTO_EXECUTE_ENABLED=false
