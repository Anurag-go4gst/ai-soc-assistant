{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": ".cursor/hooks/stop-verify-handoff.sh",
        "loop_limit": 1
      },
      {
        "command": ".cursor/hooks/stop-loop-asap-handoff.sh",
        "loop_limit": 5
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/subagent-verify-handoff.sh",
        "matcher": "implementer|generalPurpose|shell",
        "loop_limit": 1
      },
      {
        "command": ".cursor/hooks/stop-loop-asap-handoff.sh",
        "matcher": "implementer|generalPurpose|shell",
        "loop_limit": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/before-shell-guardrails.sh"
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/block-secret-paths.sh",
        "matcher": "Write|ApplyPatch|EditNotebook",
        "failClosed": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/before-submit-verify-arm.sh",
        "matcher": "UserPromptSubmit"
      },
      {
        "command": ".cursor/hooks/before-submit-plan-discipline-arm.sh",
        "matcher": "UserPromptSubmit"
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/post-plan-edit-reminder.sh",
        "matcher": "Write|ApplyPatch"
      }
    ]
  }
}
