{
  "schema_version": 1,
  "notes": "Canonical MCP RBAC for air-gapped Splunk tools. Inheritance expands allowed tools; execution still gated globally by MCP flags + HIL.",
  "default_role": "viewer",
  "session_role_map": {
    "demo_analyst": "analyst",
    "analyst": "analyst",
    "soc_lead": "soc_lead",
    "soc_analyst": "analyst",
    "viewer": "viewer"
  },
  "role_inheritance": {
    "soc_lead": ["analyst", "viewer"],
    "analyst": ["viewer"],
    "viewer": []
  },
  "roles": {
    "viewer": {
      "allowed_tools": [
        "splunk_get_info",
        "splunk_get_indexes",
        "splunk_get_metadata",
        "splunk_get_index_info",
        "splunk_get_knowledge_objects"
      ]
    },
    "analyst": {
      "allowed_tools": [
        "splunk_get_info",
        "splunk_get_indexes",
        "splunk_get_metadata",
        "splunk_get_index_info",
        "splunk_get_knowledge_objects",
        "splunk_get_user_info",
        "splunk_run_query",
        "splunk_run_saved_search"
      ]
    },
    "soc_lead": {
      "allowed_tools": [
        "splunk_get_info",
        "splunk_get_indexes",
        "splunk_get_metadata",
        "splunk_get_index_info",
        "splunk_get_knowledge_objects",
        "splunk_get_user_info",
        "splunk_run_query",
        "splunk_run_saved_search"
      ]
    }
  },
  "never_allowed": [
    "saia_generate_spl",
    "saia_explain_spl",
    "saia_optimize_spl",
    "saia_ask_splunk_question",
    "saia_assistant_chat",
    "splunk_get_user_list"
  ]
}
